# --- Domain ---
DOMAIN=your-domain.com

# --- PostgreSQL Veritabani ---
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=gulmetay_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=BURAYA_GUCLU_BIR_SIFRE_YAZIN
DATABASE_SSL=false

# --- Strapi Secret'lari ---
# Guclu rastgele degerler uretmek icin:
# openssl rand -base64 32
APP_KEYS=KEY1_BURAYA,KEY2_BURAYA,KEY3_BURAYA,KEY4_BURAYA
API_TOKEN_SALT=RASTGELE_DEGER_BURAYA
ADMIN_JWT_SECRET=RASTGELE_DEGER_BURAYA
JWT_SECRET=RASTGELE_DEGER_BURAYA
TRANSFER_TOKEN_SALT=RASTGELE_DEGER_BURAYA
