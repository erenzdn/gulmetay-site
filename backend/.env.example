# ==============================================================================
# STRAPI BACKEND ENVIRONMENT VARIABLES (PRODUCTION CHECKLIST)
# ==============================================================================
# Bu dosya, canliya gecis oncesi doldurulmasi gereken tum zorunlu ve kritik 
# parametreleri iceren uretim ortami (production) sablonudur.
# canliya almadan once bu sablonu temel alarak .env.production dosyanizi olusturun.
# ==============================================================================

# --- SUNUCU BAGLANTI AYARLARI ---
HOST=0.0.0.0
PORT=1337

# --- PROXY / GERCEK IP ---
# Nginx/Cloudflare arkasinda dogru istemci IP'sini okumak icin zorunlu (Koa proxy).
# Gelistirme asamasinda 'false' yapilabilir; uretim ortaminda 'true' olmalidir.
STRAPI_SERVER_PROXY_KOA=true

# --- CORS (ALLOWED ORIGINS) ---
# Sadece yetkilendirilmis istemcilerden gelen isteklere izin vermek icin virgulle ayrilmis origin listesi.
# Gelistirme asamasinda '*' kalabilir; uretimde sadece on-yuz domainleriniz olmalidir (ornek: https://gulmetay.mehmeterenozden.com).
CORS_ORIGINS="*"

# --- CRITICAL STRAPI SECURITY SECRETS ---
# Uretimde asla asagidaki 'tobemodified' veya hazir degerleri kullanmayin!
# Her bir degisken icin guclu, benzersiz, rastgele diziler uretin.
# Rastgele deger uretmek icin: openssl rand -base64 32
APP_KEYS="tobemodified_key1_at_least_32_chars,tobemodified_key2_at_least_32_chars"
API_TOKEN_SALT=tobemodified_salt_at_least_32_chars
ADMIN_JWT_SECRET=tobemodified_secret_at_least_32_chars
TRANSFER_TOKEN_SALT=tobemodified_salt_at_least_32_chars
JWT_SECRET=tobemodified_secret_at_least_32_chars
ENCRYPTION_KEY=tobemodified_key_at_least_32_chars

# --- VERITABANI AYARLARI (DATABASE CONFIGURATION) ---
# SQLite yerine Postgres kullanimi canli yayin icin zorunludur.
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=gulmetay_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=tobemodified_strong_db_password
DATABASE_SSL=false

# Opsiyonel: Dogrudan baglanti adresi kullanmak isterseniz (DATABASE_URL yukaridaki ayarlar yerine kullanilir)
# DATABASE_URL=postgresql://username:password@host:port/database

# --- CLOUDFLARE TURNSTILE (CAPTCHA VERIFICATION) ---
# Iletisim formunun spam korumasi icin Cloudflare Turnstile gizli anahtari.
# Bos birakilirsa veya yanlis tanimlanirsa iletisim formu POST istekleri 500 hata kodu doner.
TURNSTILE_SECRET_KEY=tobemodified_turnstile_secret_key
# Opsiyonel Siki-Lastirma: Turnstile yanitinin hangi hostname icin uretildigini dogrulamak icin tanimlayin.
# Sadece bu host'tan gelen formlar dogrulanir, sitekey calinma riskine karsi ek koruma saglar.
TURNSTILE_EXPECTED_HOSTNAME=gulmetay.mehmeterenozden.com

# --- API RATE LIMIT CONFIGURATION ---
# API kotuye kullanimini engellemek icin istek sinirlayici ayarlari.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SEC=60
RATE_LIMIT_ILETISIM_POST_MAX=5
RATE_LIMIT_ILETISIM_POST_WINDOW_SEC=60
